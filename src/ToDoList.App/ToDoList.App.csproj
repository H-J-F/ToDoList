<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ToDoList.Core\ToDoList.Core.csproj" />
    <ProjectReference Include="..\ToDoList.Storage\ToDoList.Storage.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ToDoList</AssemblyName>
    <Version>2.3.1</Version>
    <InformationalVersion>2.3.1</InformationalVersion>
    <Authors>H-J-F</Authors>
    <Copyright>Copyright (c) 2026 H-J-F</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/H-J-F/ToDoList</RepositoryUrl>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="PDFsharp-MigraDoc-WPF" Version="6.2.4" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <!-- The NuGet package also carries sample helpers and embedded Windows Phone
       fonts. Reports use installed system fonts, so do not copy those helpers. -->
  <Target Name="ExcludePdfSampleAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(Filename)' == 'PdfSharp.WPFonts' Or '%(Filename)' == 'PdfSharp.Snippets-wpf' Or '%(Filename)' == 'PdfSharp.Quality-wpf'" />
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)" Condition="'%(Filename)' == 'PdfSharp.WPFonts' Or '%(Filename)' == 'PdfSharp.Snippets-wpf' Or '%(Filename)' == 'PdfSharp.Quality-wpf'" />
    </ItemGroup>
  </Target>

</Project>

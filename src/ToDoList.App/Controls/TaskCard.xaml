<UserControl x:Class="ToDoList.App.Controls.TaskCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ClipToBounds="True">
    <StackPanel>
        <Grid Visibility="{Binding HasDateHeader, Converter={StaticResource BoolVisibility}}" Margin="8,18,0,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding DateLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
            <Border Grid.Column="1" Height="1" Background="{DynamicResource LineBrush}" Margin="14,0,8,0" VerticalAlignment="Center"/>
        </Grid>
        <Border x:Name="RowBorder" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource TaskPadding}" Background="Transparent">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="CheckButton" Width="25" Height="25" Padding="0" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold" Content="{Binding StateGlyph}" ToolTip="{Binding StateHint}" PreviewMouseLeftButtonDown="Check_Down" PreviewMouseLeftButtonUp="Check_Up" MouseLeave="Check_Leave" LostMouseCapture="Check_LostCapture" PreviewKeyDown="Check_KeyDown">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Background" Value="{DynamicResource GreenBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GreenBrush}"/><Setter Property="Foreground" Value="White"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsVerification}" Value="True"><Setter Property="Background" Value="{DynamicResource YellowBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}"/><Setter Property="Foreground" Value="White"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                        </Style.Triggers>
                    </Style></Button.Style>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="BodyText" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" FontSize="{DynamicResource BodyFontSize}" MinHeight="24" MouseLeftButtonDown="Body_Down" ToolTip="双击编辑内容"/>
                    <ContentControl x:Name="EditorHost" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding ProjectLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="待验证" Foreground="{DynamicResource YellowBrush}" FontSize="11" Visibility="{Binding IsVerification, Converter={StaticResource BoolVisibility}}"/>
                        <TextBlock Text="{Binding CompletionLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>

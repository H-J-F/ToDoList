<UserControl x:Class="ToDoList.App.Controls.TaskCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ClipToBounds="True" Focusable="True" KeyboardNavigation.TabNavigation="Local" AutomationProperties.Name="{Binding Item.PlainText}">
    <UserControl.ContextMenu><ContextMenu Opened="Menu_Opened"><MenuItem x:Name="DeleteRestoreMenu" Click="DeleteRestore_Click"/></ContextMenu></UserControl.ContextMenu>
    <StackPanel>
        <Grid Visibility="{Binding HasDateHeader, Converter={StaticResource BoolVisibility}}" Margin="8,18,0,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding DateLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
            <Border Grid.Column="1" Height="1" Background="{DynamicResource LineBrush}" Margin="14,0,8,0" VerticalAlignment="Center"/>
        </Grid>
        <Border x:Name="RowBorder" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource TaskPadding}" CornerRadius="6" Background="Transparent">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <CheckBox x:Name="CheckButton" MinWidth="24" MinHeight="24" Padding="0" IsThreeState="True" IsChecked="{Binding CheckState, Mode=OneWay}" ToolTip="{Binding StateHint}" PreviewMouseLeftButtonDown="Check_Down" PreviewMouseLeftButtonUp="Check_Up" MouseLeave="Check_Leave" LostMouseCapture="Check_LostCapture" PreviewKeyDown="Check_KeyDown" Click="Check_Click">
                        <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsDeleted}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></CheckBox.Style>
                    </CheckBox>
                    <fluent:SymbolIcon Symbol="Delete20" FontSize="22" Foreground="{DynamicResource RedBrush}" ToolTip="已删除 · 右键恢复" Visibility="{Binding IsDeleted, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="BodyText" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" FontSize="{DynamicResource BodyFontSize}" MinHeight="24" MouseLeftButtonDown="Body_Down" ToolTip="双击编辑内容"/>
                    <ContentControl x:Name="EditorHost" Visibility="Collapsed"/>
                    <WrapPanel Margin="0,5,0,0" ToolTip="{Binding TimeDetails}">
                        <TextBlock Text="{Binding ProjectLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="待验证" Foreground="{DynamicResource YellowBrush}" FontSize="11" Margin="0,0,10,0" Visibility="{Binding IsVerification, Converter={StaticResource BoolVisibility}}"/>
                        <TextBlock Text="{Binding CreationLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding CompletionLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>

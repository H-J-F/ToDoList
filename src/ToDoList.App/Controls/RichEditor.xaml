<UserControl x:Class="ToDoList.App.Controls.RichEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
            <Button Content="B" FontWeight="Bold" Padding="8,3" Style="{StaticResource QuietButton}" Focusable="False" Click="Bold_Click" ToolTip="粗体 Ctrl+B"/>
            <Button Content="I" FontStyle="Italic" Padding="8,3" Style="{StaticResource QuietButton}" Focusable="False" Click="Italic_Click" ToolTip="斜体 Ctrl+I"/>
            <Button Content="U" Padding="8,3" Style="{StaticResource QuietButton}" Focusable="False" Click="Underline_Click" ToolTip="下划线 Ctrl+U"/>
            <Button Content="●" Foreground="#BC6852" Padding="7,3" Style="{StaticResource QuietButton}" Focusable="False" Click="Color_Click" Tag="#BC6852" ToolTip="珊瑚色"/>
            <Button Content="●" Foreground="#528E68" Padding="7,3" Style="{StaticResource QuietButton}" Focusable="False" Click="Color_Click" Tag="#528E68" ToolTip="绿色"/>
            <Button Content="●" Foreground="#8270AC" Padding="7,3" Style="{StaticResource QuietButton}" Focusable="False" Click="Color_Click" Tag="#8270AC" ToolTip="紫色"/>
            <Button Content="↗" Padding="8,3" Style="{StaticResource QuietButton}" Focusable="False" Click="Link_Click" ToolTip="添加链接"/>
            <Button Content="☺" Padding="8,3" Style="{StaticResource QuietButton}" Focusable="False" Click="Emoji_Click" ToolTip="插入表情，也可按 Win + ."/>
            <Button Content="清除格式" FontSize="11" Padding="6,3" Style="{StaticResource QuietButton}" Focusable="False" Click="ClearFormat_Click"/>
        </StackPanel>
        <RichTextBox x:Name="Editor" Grid.Row="1" MinHeight="44" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource InkBrush}" FontSize="{DynamicResource BodyFontSize}" Padding="3" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" PreviewKeyDown="Editor_KeyDown" TextChanged="Editor_TextChanged"/>
    </Grid>
</UserControl>

<UserControl x:Class="ToDoList.App.Controls.RichEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
            <Button FontWeight="Bold" Padding="8,3" Style="{StaticResource ToolbarButton}" Focusable="False" Click="Bold_Click" ToolTip="粗体 Ctrl+B"><fluent:SymbolIcon Symbol="TextBold20" FontSize="16"/></Button>
            <Button FontStyle="Italic" Padding="8,3" Style="{StaticResource ToolbarButton}" Focusable="False" Click="Italic_Click" ToolTip="斜体 Ctrl+I"><fluent:SymbolIcon Symbol="TextItalic20" FontSize="16"/></Button>
            <Button Padding="8,3" Style="{StaticResource ToolbarButton}" Focusable="False" Click="Underline_Click" ToolTip="下划线 Ctrl+U"><fluent:SymbolIcon Symbol="TextUnderline20" FontSize="16"/></Button>
            <Button Foreground="#BC6852" Padding="7,3" Style="{StaticResource ToolbarButton}" Focusable="False" Click="Color_Click" Tag="#BC6852" ToolTip="珊瑚色"><Ellipse Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
            <Button Foreground="#528E68" Padding="7,3" Style="{StaticResource ToolbarButton}" Focusable="False" Click="Color_Click" Tag="#528E68" ToolTip="绿色"><Ellipse Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
            <Button Foreground="#8270AC" Padding="7,3" Style="{StaticResource ToolbarButton}" Focusable="False" Click="Color_Click" Tag="#8270AC" ToolTip="紫色"><Ellipse Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
            <Button Padding="8,3" Style="{StaticResource ToolbarButton}" Focusable="False" Click="Link_Click" ToolTip="添加链接"><fluent:SymbolIcon Symbol="Link20" FontSize="16"/></Button>
            <Button Padding="8,3" Style="{StaticResource ToolbarButton}" Focusable="False" Click="Emoji_Click" ToolTip="插入表情，也可按 Win + ."><fluent:SymbolIcon Symbol="Emoji20" FontSize="16"/></Button>
            <Button FontSize="11" Padding="6,3" Style="{StaticResource ToolbarButton}" Focusable="False" Click="ClearFormat_Click"><fluent:SymbolIcon Symbol="TextClearFormatting20" FontSize="16"/></Button>
        </StackPanel>
        <Grid Grid.Row="1"><TextBlock x:Name="Placeholder" Text="输入任务内容…  Ctrl+Enter 添加" Foreground="{DynamicResource MutedBrush}" Margin="4,5" IsHitTestVisible="False"/>
        <RichTextBox x:Name="Editor" Grid.Row="1" MinHeight="44" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource InkBrush}" FontSize="{DynamicResource BodyFontSize}" Padding="3" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" PreviewKeyDown="Editor_KeyDown" TextChanged="Editor_TextChanged"/>
        </Grid>
    </Grid>
</UserControl>

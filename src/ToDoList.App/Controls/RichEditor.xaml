<UserControl x:Class="ToDoList.App.Controls.RichEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
            <fluent:Button Style="{StaticResource ToolbarButton}" Focusable="True" Click="Bold_Click" ToolTip="粗体 Ctrl+B" AutomationProperties.Name="粗体"><fluent:SymbolIcon Symbol="TextBold20" FontSize="20"/></fluent:Button>
            <fluent:Button Style="{StaticResource ToolbarButton}" Focusable="True" Click="Italic_Click" ToolTip="斜体 Ctrl+I" AutomationProperties.Name="斜体"><fluent:SymbolIcon Symbol="TextItalic20" FontSize="20"/></fluent:Button>
            <fluent:Button Style="{StaticResource ToolbarButton}" Focusable="True" Click="Underline_Click" ToolTip="下划线 Ctrl+U" AutomationProperties.Name="下划线"><fluent:SymbolIcon Symbol="TextUnderline20" FontSize="20"/></fluent:Button>
            <fluent:Button x:Name="ColorButton" Style="{StaticResource ToolbarButton}" Click="Color_Click" ToolTip="文字颜色 · 预设、自定义与自动颜色" AutomationProperties.Name="文字颜色"><StackPanel><fluent:SymbolIcon Symbol="TextColor20" FontSize="20"/><Rectangle x:Name="ColorIndicator" Height="3" Width="18" Fill="{DynamicResource InkBrush}"/></StackPanel></fluent:Button>
            <fluent:Button Style="{StaticResource ToolbarButton}" Focusable="True" Click="Link_Click" ToolTip="添加链接" AutomationProperties.Name="添加链接"><fluent:SymbolIcon Symbol="Link20" FontSize="20"/></fluent:Button>
            <fluent:Button x:Name="EmojiButton" Style="{StaticResource ToolbarButton}" Focusable="True" Click="Emoji_Click" ToolTip="插入彩色表情" AutomationProperties.Name="插入彩色表情"><fluent:SymbolIcon Symbol="Emoji20" FontSize="20"/></fluent:Button>
            <fluent:Button Style="{StaticResource QuietButton}" MinHeight="32" Height="32" Padding="6,0" Focusable="True" Click="ClearFormat_Click" ToolTip="清除格式：恢复选中文字或后续输入的默认格式" AutomationProperties.Name="清除格式"><StackPanel Orientation="Horizontal"><fluent:SymbolIcon Symbol="TextClearFormatting20" FontSize="20"/><TextBlock Text="清除格式" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></fluent:Button>
        </StackPanel>
        <Grid Grid.Row="1"><TextBlock x:Name="Placeholder" Text="输入任务内容…  Ctrl+Enter 添加" Foreground="{DynamicResource MutedBrush}" Margin="4,5" IsHitTestVisible="False"/>
        <RichTextBox x:Name="Editor" Grid.Row="1" MinHeight="44" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource InkBrush}" FontSize="{DynamicResource BodyFontSize}" Padding="3" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" PreviewKeyDown="Editor_KeyDown" TextChanged="Editor_TextChanged"/>
        </Grid>
    </Grid>
</UserControl>

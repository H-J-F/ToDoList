<fluent:FluentWindow x:Class="ToDoList.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ui="clr-namespace:ToDoList.App.Controls" xmlns:services="clr-namespace:ToDoList.App.Services" Title="ToDoList" Width="1100" Height="760" MinWidth="800" MinHeight="560" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Microsoft YaHei UI, Segoe UI Emoji" FontSize="{DynamicResource BodyFontSize}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <fluent:TitleBar x:Name="AppTitleBar" Background="{DynamicResource CanvasBrush}" Grid.Row="0" Title="{Binding BookTitle, StringFormat=ToDoList · {0}}" Height="32" ><fluent:TitleBar.Icon><fluent:SymbolIcon Symbol="TaskListSquareLtr24" Foreground="{DynamicResource AccentInkBrush}" FontSize="20"/></fluent:TitleBar.Icon></fluent:TitleBar>
        <Grid Grid.Row="1">
            <Grid x:Name="WorkArea">
                <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SidebarBrush}"><Grid Margin="16,20,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="工作空间" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,10"/>
                        <ComboBox x:Name="BookSelector" ItemsSource="{Binding VisibleBooks}" DisplayMemberPath="DisplayTitle" SelectionChanged="Book_Changed" AutomationProperties.AutomationId="BookSelector"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                            <fluent:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,7" Margin="0,0,4,0" Style="{StaticResource QuietButton}" Click="NewBook_Click"><StackPanel Orientation="Horizontal"><fluent:SymbolIcon Symbol="Add20" Margin="0,0,8,0"/><TextBlock Text="新建待办笔记"/></StackPanel></fluent:Button>
                            <fluent:Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="BookMenu_Click" ToolTip="笔记操作"><fluent:SymbolIcon Symbol="MoreHorizontal20"/></fluent:Button>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="8,24,0,8"><TextBlock Text="模块" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/><fluent:Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="NewProject_Click" IsEnabled="{Binding HasBook}" ToolTip="新增模块"><fluent:SymbolIcon Symbol="Add20"/></fluent:Button></Grid>
                    <ListBox x:Name="ProjectList" Grid.Row="2" ItemsSource="{Binding Projects}" SelectionChanged="Project_Changed" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False" AutomationProperties.AutomationId="ProjectList">
                        <ListBox.Resources><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"/></ListBox.Resources>
                        <ListBox.ContextMenu><ContextMenu><MenuItem Header="新增模块" Click="NewProject_Click"/><MenuItem Header="重命名模块" Click="RenameProject_Click"/><MenuItem Header="迁移到其他笔记" Click="MigrateProject_Click"/><MenuItem Header="上移" Click="MoveProjectUp_Click"/><MenuItem Header="下移" Click="MoveProjectDown_Click"/><Separator/><MenuItem Header="删除模块…" Click="DeleteProject_Click"/></ContextMenu></ListBox.ContextMenu>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><fluent:SymbolIcon Symbol="Folder20" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="12,11"/><Setter Property="Border.CornerRadius" Value="6"/><Setter Property="Margin" Value="0,2"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel Grid.Row="3">
                        <Grid x:Name="AccountEntry" Margin="0,0,0,10">
                            <fluent:Button x:Name="AccountButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="40" Padding="12,0" Click="Account_Click" ToolTip="账号与同步" AutomationProperties.AutomationId="Account" AutomationProperties.Name="账号与同步">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                        <fluent:SymbolIcon x:Name="AccountAvatar" Symbol="PersonCircle20" FontSize="20" Foreground="{DynamicResource MutedBrush}"/>
                                        <Image x:Name="AccountAvatarImage" Width="20" Height="20" Stretch="UniformToFill" Visibility="Collapsed"><Image.Clip><EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10"/></Image.Clip></Image>
                                    </Grid>
                                    <TextBlock x:Name="AccountName" Grid.Column="2" Text="未登录" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="AccountName"/>
                                </Grid>
                            </fluent:Button>
                        </Grid>
                        <fluent:Button x:Name="SettingsButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource QuietButton}" Height="40" Padding="12,0" Click="Settings_Click" AutomationProperties.AutomationId="Settings"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><fluent:SymbolIcon x:Name="SettingsIcon" Symbol="Settings20" FontSize="20" Width="20" Height="20" VerticalAlignment="Center"/><TextBlock x:Name="SettingsLabel" Grid.Column="2" Text="设置" VerticalAlignment="Center"/></Grid></fluent:Button>
                    </StackPanel>
                </Grid>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,0,0" CornerRadius="10,0,0,0">
                    <Grid x:Name="MainPage" Margin="24,20,24,20" Visibility="{Binding HasBook, Converter={StaticResource BoolVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageHeading" Text="{Binding FilterTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="{Binding DateSubtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/></StackPanel><fluent:Button Grid.Column="1" Content="导出报告" Click="Report_Click" Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="ExportReport"/></Grid>
                        <Grid x:Name="BookmarkArea" Grid.Row="1" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                            <fluent:DynamicScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal"><TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" SelectionChanged="Tab_Changed" Padding="0">
                                    <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Margin="8,3"/></DataTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style></TabControl.Resources>
                                    <TabItem Header="所有" Tag="All"/><TabItem Header="已删除" Tag="Deleted"/><TabItem Header="已完成" Tag="Completed"/><TabItem Header="未完成" Tag="Open"/><TabItem Header="本月" Tag="Month"/><TabItem Header="本周" Tag="Week"/><TabItem Header="今天" Tag="Today" IsSelected="True"/>
                                </TabControl><fluent:Button x:Name="CalendarButton" Click="Calendar_Click" ToolTip="按年、月、日查看任务" AutomationProperties.AutomationId="CalendarFilter" Margin="4,0,0,0"><fluent:Button.Style><Style TargetType="fluent:Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCalendarFilter}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></fluent:Button.Style><fluent:SymbolIcon Symbol="CalendarLtr20"/></fluent:Button></StackPanel>
                            </fluent:DynamicScrollViewer>
                            <TextBlock Grid.Row="1" Text="{Binding LoadedLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <StackPanel x:Name="DeletedActions" Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBlock x:Name="DeletedSelectionCount" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <fluent:Button x:Name="DeleteSelectedButton" Content="彻底删除…" Click="DeleteSelected_Click" Margin="0,0,8,0"/>
                                <fluent:Button Content="取消多选" Click="CancelDeletedSelection_Click"/>
                            </StackPanel>
                            <Border Grid.Row="1" HorizontalAlignment="Right" Width="132" Background="Transparent" Visibility="{Binding IsCompletedTab, Converter={StaticResource BoolVisibility}}">
                                <ComboBox x:Name="SortSelector" MinHeight="36" Padding="10,5" SelectionChanged="Sort_Changed" AutomationProperties.AutomationId="SortSelector">
                                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Opacity" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value="1"/></Trigger><Trigger Property="IsDropDownOpen" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers></Style></ComboBox.Style>
                                    <ComboBoxItem Content="添加日期"/><ComboBoxItem Content="完成日期"/>
                                </ComboBox>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" x:Name="TaskContent">
                            <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" ScrollViewer.ScrollChanged="TaskList_ScrollChanged" AutomationProperties.AutomationId="TaskList">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,0,16,0"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><ui:TaskCard StateRequested="Task_StateRequested" DeleteRestoreRequested="Task_DeleteRestoreRequested" EditRequested="Task_EditRequested" SaveRequested="Task_SaveRequested" CancelRequested="Task_CancelRequested"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
                                <fluent:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="42" Foreground="{DynamicResource AccentInkBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="这里还没有任务" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="添加任务，或切换其他模块与日期" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="3" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DraftProject" ItemsSource="{Binding DraftProjects}" DisplayMemberPath="Name" SelectionChanged="DraftProject_Changed"/>
                                    <fluent:TextBox x:Name="NewProjectName" Grid.Column="1" Margin="8,0" Visibility="Collapsed" ToolTip="新模块名称" MaxLength="100"/>
                                    <fluent:Button Grid.Column="2" Content="添加任务" Icon="{fluent:SymbolIcon Add20, FontSize=20}" Appearance="Primary" Click="AddTask_Click" ToolTip="Enter 添加，Shift+Enter 换行" AutomationProperties.AutomationId="AddTask"/>
                                </Grid>
                                <ui:RichEditor x:Name="DraftEditor" Grid.Row="1" Height="80" Margin="0,8,0,0" Submit="Draft_Submit"/>
                            </Grid>
                        </Border>
                        <Image x:Name="BookTransitionSnapshot" Grid.RowSpan="4" Panel.ZIndex="20" Visibility="Collapsed" Stretch="Fill" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" x:Name="Onboarding"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasBook}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="30"><Image x:Name="WelcomeIcon" Width="96" Height="96" Margin="0,0,0,24"/><TextBlock Text="{Binding WelcomeTitle}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding WelcomeDescription}" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,24"/><fluent:Button x:Name="ShowHiddenWelcome" Content="显示隐藏笔记" Click="ShowHiddenBooks_Click" Visibility="{Binding HasHiddenBooks, Converter={StaticResource BoolVisibility}}" Width="200" Height="40" HorizontalAlignment="Center" Margin="0,0,0,12"/><fluent:Button Content="创建待办笔记" Icon="{fluent:SymbolIcon Add20, FontSize=20}" Appearance="Primary" Click="NewBook_Click" Width="200" Height="40" HorizontalAlignment="Center"/><fluent:Button Content="导入已有待办笔记" Style="{StaticResource QuietButton}" Click="Import_Click" Width="200" Height="40" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
                </Grid>
            </Grid>
            <Border x:Name="SettingsPanel" Width="440" HorizontalAlignment="Right" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid Margin="24,16,20,16">
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="让待办清单更适合你" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                        <fluent:Button x:Name="CloseSettingsButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="CloseSettings_Click" ToolTip="关闭设置" AutomationProperties.Name="关闭设置"><fluent:SymbolIcon Symbol="Dismiss24" FontSize="24"/></fluent:Button>
                    </Grid>
                    <!-- Reserve the overlay scrollbar hit area outside the cards. -->
                    <fluent:DynamicScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Margin="20,0,4,0">
                        <StackPanel x:Name="SettingsContent" Margin="0,0,20,24">
                            <TextBlock Text="外观与体验" FontWeight="SemiBold" Margin="4,4,0,12"/>
                            <fluent:CardControl Header="主题" Style="{StaticResource SettingCard}" Icon="{fluent:SymbolIcon Color20, FontSize=24}">
                                <ComboBox x:Name="ThemeSetting" Style="{StaticResource ThemeSelector}" SelectedValuePath="Id" SelectionChanged="Setting_Changed" AutomationProperties.Name="主题">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding Description}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate><DataTemplate><Border Width="6" Height="14" Margin="0,0,1,0" CornerRadius="2" Background="{Binding}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0.5"/></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </fluent:CardControl>
                            <fluent:CardControl Header="正文字号" Style="{StaticResource SettingCard}" Icon="{fluent:SymbolIcon TextFontSize20, FontSize=24}">
                                <ComboBox x:Name="FontSetting" Style="{StaticResource SettingSelector}" SelectionChanged="Setting_Changed" AutomationProperties.Name="正文字号"/>
                            </fluent:CardControl>
                            <fluent:CardControl Header="任务间距" Style="{StaticResource SettingCard}" Icon="{fluent:SymbolIcon TextLineSpacing20, FontSize=24}">
                                <ComboBox x:Name="DensitySetting" Style="{StaticResource SettingSelector}" SelectionChanged="Setting_Changed" AutomationProperties.Name="任务间距"/>
                            </fluent:CardControl>
                            <fluent:CardControl Header="动画效果" Style="{StaticResource SettingCard}" Icon="{fluent:SymbolIcon Sparkle20, FontSize=24}">
                                <ComboBox x:Name="MotionSetting" Style="{StaticResource SettingSelector}" SelectionChanged="Setting_Changed" AutomationProperties.Name="动画效果"/>
                            </fluent:CardControl>
                            <TextBlock Text="导出文档标记颜色 · #RRGGBB" FontWeight="SemiBold" Margin="4,12,0,8"/>
                            <Grid Margin="4,0,4,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="未完成" FontSize="12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border x:Name="OpenColorPreview" Width="18" Height="18" Margin="0,0,6,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                                        <TextBox Grid.Column="1" x:Name="OpenColorSetting" TextChanged="StatusColor_TextChanged" LostKeyboardFocus="StatusColor_LostFocus" ContextMenuOpening="StatusColor_MenuOpening" ContextMenuClosing="StatusColor_MenuClosing"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0">
                                    <TextBlock Text="待验证" FontSize="12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border x:Name="VerificationColorPreview" Width="18" Height="18" Margin="0,0,6,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                                        <TextBox Grid.Column="1" x:Name="VerificationColorSetting" TextChanged="StatusColor_TextChanged" LostKeyboardFocus="StatusColor_LostFocus" ContextMenuOpening="StatusColor_MenuOpening" ContextMenuClosing="StatusColor_MenuClosing"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="已完成" FontSize="12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border x:Name="CompletedColorPreview" Width="18" Height="18" Margin="0,0,6,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                                        <TextBox Grid.Column="1" x:Name="CompletedColorSetting" TextChanged="StatusColor_TextChanged" LostKeyboardFocus="StatusColor_LostFocus" ContextMenuOpening="StatusColor_MenuOpening" ContextMenuClosing="StatusColor_MenuClosing"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <fluent:Button Content="恢复外观默认值" Icon="{fluent:SymbolIcon ArrowReset20, FontSize=20}" Click="ResetSettings_Click" HorizontalAlignment="Stretch" Margin="0,4,0,24"/>
                            <TextBlock Text="数据与关于" FontWeight="SemiBold" Margin="4,0,0,12"/>
                            <fluent:Button Content="打开 Data 目录" Icon="{fluent:SymbolIcon FolderOpen20, FontSize=20}" Click="OpenData_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                            <fluent:Button Content="打开备份目录" Icon="{fluent:SymbolIcon History20, FontSize=20}" Click="OpenBackup_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,16"/>
                            <fluent:CardAction x:Name="AboutCard" Click="OpenRepository_Click" IsChevronVisible="False" HorizontalContentAlignment="Stretch" ToolTip="打开 GitHub 仓库" AutomationProperties.Name="打开 ToDoList GitHub 仓库">
                                <fluent:CardAction.Content><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="AboutIcon" Width="40" Height="40" Margin="0,0,12,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{x:Static services:ApplicationLinks.DisplayName}" FontWeight="SemiBold"/><TextBlock Text="H-J-F · MIT · GitHub" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><fluent:SymbolIcon Grid.Column="2" Symbol="Open20" FontSize="20" Margin="12,0,0,0"/></Grid></fluent:CardAction.Content>
                            </fluent:CardAction>
                        </StackPanel>
                    </fluent:DynamicScrollViewer>
                </Grid>
            </Border>
            <Border x:Name="AccountPanel" Width="440" HorizontalAlignment="Right" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid Margin="24,16,20,16">
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="账号与同步" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="AccountIdentity" Text="本地空间" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                        <fluent:Button x:Name="CloseAccountButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="CloseAccount_Click" ToolTip="关闭账号与同步" AutomationProperties.Name="关闭账号与同步"><fluent:SymbolIcon Symbol="Dismiss24" FontSize="24"/></fluent:Button>
                    </Grid>
                    <fluent:DynamicScrollViewer x:Name="AccountScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Margin="20,0,4,0">
                        <StackPanel x:Name="AccountContent" Margin="0,0,20,24">
                            <TextBlock Text="云存档 · 腾讯微云" FontWeight="SemiBold" Margin="4,4,0,12"/>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock x:Name="CloudStatus" Text="本地空间 · 登录后支持云同步" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.AutomationId="CloudStatus"/>
                                    <fluent:Button Content="查看运行日志" Click="OpenRunLog_Click" HorizontalAlignment="Left" Margin="0,0,0,10" AutomationProperties.AutomationId="OpenRunLog"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock x:Name="CloudLastSync" Text="尚未同步" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="CloudSyncDuration" Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                    <fluent:Button x:Name="CloudLoginButton" Content="微信登录微云" Click="CloudLogin_Click" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CloudLogin"/>
                                    <TextBlock Text="扫码授权即同意使用当前微云空间保存 ToDoList 云存档。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,10"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <fluent:Button x:Name="CloudSyncButton" Content="立即同步" Click="CloudSync_Click" IsEnabled="False" Margin="0,0,4,0" AutomationProperties.AutomationId="CloudSync"/>
                                        <fluent:Button x:Name="CloudUploadButton" Grid.Column="1" Content="上传变更" Click="CloudUpload_Click" IsEnabled="False" Margin="2,0"/>
                                        <fluent:Button x:Name="CloudDownloadButton" Grid.Column="2" Content="下载变更" Click="CloudDownload_Click" IsEnabled="False" Margin="4,0,0,0"/>
                                    </Grid>
                                    <CheckBox x:Name="CloudAutoSync" Content="自动同步" IsChecked="True" Checked="CloudAuto_Changed" Unchecked="CloudAuto_Changed" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="CloudIntervalLabel" Text="同步周期：5 分钟" Margin="0,4,0,4"/>
                                    <ui:SyncIntervalSlider x:Name="CloudInterval" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="0" ValueChanged="CloudInterval_Changed" AutomationProperties.Name="自动同步周期" Margin="0,0,0,2" Style="{StaticResource SquareIntervalSlider}"/>
                                    <TextBlock Text="分钟" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,12"/>
                                    <fluent:Button x:Name="CloudConflictsButton" Content="处理同步冲突" Click="CloudConflicts_Click" IsEnabled="False" HorizontalAlignment="Stretch" Margin="0,0,0,8" AutomationProperties.AutomationId="CloudConflicts"/>
                                    <fluent:Button x:Name="CloudCopyButton" Content="导入本地笔记到当前账号" Click="CloudCopy_Click" IsEnabled="False" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                    <fluent:Button x:Name="CloudLogoutButton" Content="退出微云，返回本地空间" Click="CloudLogout_Click" IsEnabled="False" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CloudLogout"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="登录后使用当前账号的独立空间。本地笔记可按原标题导入，原本地空间继续保留。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="4,0,4,12"/>
                        </StackPanel>
                    </fluent:DynamicScrollViewer>
                </Grid>
            </Border>
            <Border x:Name="BlockingOverlay" Background="{DynamicResource PaperBrush}" Visibility="{Binding ShowBlockingOverlay, Converter={StaticResource BoolVisibility}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280"><TextBlock Text="{Binding LoadingMessage}"/><ProgressBar IsIndeterminate="{Binding LoadingIndeterminate}" Value="{Binding LoadingProgress}" Maximum="1" Height="4" Margin="0,16,0,0"/><fluent:Button x:Name="CancelInitialCloudLoad" Content="取消加载" Click="CancelInitialCloudLoad_Click" Visibility="{Binding CanCancelInitialLoad, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" Margin="0,16,0,0"/></StackPanel></Border>
            <ui:OperationToast x:Name="Notifications" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="24,0,24,178"/>
            <fluent:ContentDialogHost x:Name="DialogHost"/>
        </Grid>
    </Grid>
</fluent:FluentWindow>

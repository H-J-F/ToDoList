<fluent:FluentWindow x:Class="ToDoList.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fluent="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ui="clr-namespace:ToDoList.App.Controls" Title="ToDoList" Width="1100" Height="760" MinWidth="800" MinHeight="560" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Microsoft YaHei UI, Segoe UI Emoji" FontSize="{DynamicResource BodyFontSize}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <fluent:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{Binding BookTitle, StringFormat=ToDoList · {0}}" Height="32" ><fluent:TitleBar.Icon><fluent:SymbolIcon Symbol="TaskListSquareLtr24" Foreground="{DynamicResource AccentInkBrush}" FontSize="20"/></fluent:TitleBar.Icon></fluent:TitleBar>
        <Grid Grid.Row="1">
            <Grid x:Name="WorkArea">
                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid Margin="16,20,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="工作空间" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,10"/>
                        <ComboBox x:Name="BookSelector" ItemsSource="{Binding Books}" DisplayMemberPath="Title" SelectionChanged="Book_Changed" AutomationProperties.AutomationId="BookSelector"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                            <fluent:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,7" Margin="0,0,4,0" Style="{StaticResource QuietButton}" Click="NewBook_Click"><StackPanel Orientation="Horizontal"><fluent:SymbolIcon Symbol="Add20" Margin="0,0,8,0"/><TextBlock Text="新建待办书"/></StackPanel></fluent:Button>
                            <fluent:Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="BookMenu_Click" ToolTip="导入与导出"><fluent:SymbolIcon Symbol="MoreHorizontal20"/></fluent:Button>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="8,24,0,8"><TextBlock Text="模块" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/><fluent:Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="NewProject_Click" IsEnabled="{Binding HasBook}" ToolTip="新增模块"><fluent:SymbolIcon Symbol="Add20"/></fluent:Button></Grid>
                    <ListBox x:Name="ProjectList" Grid.Row="2" ItemsSource="{Binding Projects}" SelectionChanged="Project_Changed" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.AutomationId="ProjectList">
                        <ListBox.Resources><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"/></ListBox.Resources>
                        <ListBox.ContextMenu><ContextMenu><MenuItem Header="新增模块" Click="NewProject_Click"><MenuItem.Icon><fluent:SymbolIcon Symbol="Add20"/></MenuItem.Icon></MenuItem></ContextMenu></ListBox.ContextMenu>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><fluent:SymbolIcon Symbol="Folder20" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="12,11"/><Setter Property="Border.CornerRadius" Value="6"/><Setter Property="Margin" Value="0,2"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                    </ListBox>
                    <fluent:Button x:Name="SettingsButton" Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource QuietButton}" Click="Settings_Click" AutomationProperties.AutomationId="Settings"><StackPanel Orientation="Horizontal"><fluent:SymbolIcon Symbol="Settings20" Margin="0,0,10,0"/><TextBlock Text="设置"/></StackPanel></fluent:Button>
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,0,0" CornerRadius="10,0,0,0">
                    <Grid x:Name="MainPage" Margin="24,20,24,20" Visibility="{Binding HasBook, Converter={StaticResource BoolVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageHeading" Text="{Binding FilterTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="{Binding DateSubtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/></StackPanel><fluent:Button Grid.Column="1" Content="导出报告" Click="Report_Click" Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="ExportReport"/></Grid>
                        <Grid x:Name="BookmarkArea" Grid.Row="1" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                            <fluent:DynamicScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal"><TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" SelectionChanged="Tab_Changed" Padding="0">
                                    <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Margin="8,3"/></DataTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style></TabControl.Resources>
                                    <TabItem Header="所有" Tag="All"/><TabItem Header="已删除" Tag="Deleted"/><TabItem Header="已完成" Tag="Completed"/><TabItem Header="未完成" Tag="Open"/><TabItem Header="本月" Tag="Month"/><TabItem Header="本周" Tag="Week"/><TabItem Header="今天" Tag="Today" IsSelected="True"/>
                                </TabControl><fluent:Button x:Name="CalendarButton" Click="Calendar_Click" ToolTip="按年、月、日查看任务" AutomationProperties.AutomationId="CalendarFilter" Margin="4,0,0,0"><fluent:Button.Style><Style TargetType="fluent:Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCalendarFilter}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></fluent:Button.Style><fluent:SymbolIcon Symbol="CalendarLtr20"/></fluent:Button></StackPanel>
                            </fluent:DynamicScrollViewer>
                            <TextBlock Grid.Row="1" Text="{Binding LoadedLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" HorizontalAlignment="Right" Width="132" Background="Transparent" Visibility="{Binding IsCompletedTab, Converter={StaticResource BoolVisibility}}">
                                <ComboBox x:Name="SortSelector" MinHeight="36" Padding="10,5" SelectionChanged="Sort_Changed" AutomationProperties.AutomationId="SortSelector">
                                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Opacity" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value="1"/></Trigger><Trigger Property="IsDropDownOpen" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers></Style></ComboBox.Style>
                                    <ComboBoxItem Content="添加日期"/><ComboBoxItem Content="完成日期"/>
                                </ComboBox>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" x:Name="TaskContent">
                            <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" ScrollViewer.ScrollChanged="TaskList_ScrollChanged" AutomationProperties.AutomationId="TaskList">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,0,16,0"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><ui:TaskCard StateRequested="Task_StateRequested" DeleteRestoreRequested="Task_DeleteRestoreRequested" EditRequested="Task_EditRequested" SaveRequested="Task_SaveRequested" CancelRequested="Task_CancelRequested"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
                                <fluent:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="42" Foreground="{DynamicResource AccentInkBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="这里还没有任务" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="添加任务，或切换其他模块与日期" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="3" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DraftProject" ItemsSource="{Binding DraftProjects}" DisplayMemberPath="Name" SelectionChanged="DraftProject_Changed"/>
                                    <fluent:TextBox x:Name="NewProjectName" Grid.Column="1" Margin="8,0" Visibility="Collapsed" ToolTip="新模块名称" MaxLength="100"/>
                                    <fluent:Button Grid.Column="2" Content="添加任务" Icon="{fluent:SymbolIcon Add20, FontSize=20}" Appearance="Primary" Click="AddTask_Click" ToolTip="Enter 添加，Shift+Enter 换行" AutomationProperties.AutomationId="AddTask"/>
                                </Grid>
                                <ui:RichEditor x:Name="DraftEditor" Grid.Row="1" Height="80" Margin="0,8,0,0" Submit="Draft_Submit"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" x:Name="Onboarding"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasBook}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="30"><Image x:Name="WelcomeIcon" Width="96" Height="96" Margin="0,0,0,24"/><TextBlock Text="开始安排你的每一天" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="创建一本待办书，按模块整理任务。" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,24"/><fluent:Button Content="创建待办书" Icon="{fluent:SymbolIcon Add20, FontSize=20}" Appearance="Primary" Click="NewBook_Click" Width="200" Height="40" HorizontalAlignment="Center"/><fluent:Button Content="导入已有待办书" Style="{StaticResource QuietButton}" Click="Import_Click" Width="200" Height="40" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
                </Grid>
            </Grid>
            <Border x:Name="SettingsPanel" Width="440" HorizontalAlignment="Right" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid Margin="24,16,20,16">
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="让待办清单更适合你" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                        <fluent:Button x:Name="CloseSettingsButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="CloseSettings_Click" ToolTip="关闭设置" AutomationProperties.Name="关闭设置"><fluent:SymbolIcon Symbol="Dismiss24" FontSize="24"/></fluent:Button>
                    </Grid>
                    <!-- Reserve the overlay scrollbar hit area outside the cards. -->
                    <fluent:DynamicScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Margin="20,0,4,0">
                        <StackPanel x:Name="SettingsContent" Margin="0,0,20,24">
                            <TextBlock Text="外观与体验" FontWeight="SemiBold" Margin="4,4,0,12"/>
                            <fluent:CardControl Header="显示模式" Style="{StaticResource SettingCard}" Icon="{fluent:SymbolIcon WeatherMoon20, FontSize=24}">
                                <ComboBox x:Name="ModeSetting" Style="{StaticResource SettingSelector}" SelectionChanged="Setting_Changed" AutomationProperties.Name="显示模式"/>
                            </fluent:CardControl>
                            <fluent:CardControl Header="强调色" Style="{StaticResource SettingCard}" Icon="{fluent:SymbolIcon Color20, FontSize=24}">
                                <ComboBox x:Name="PaletteSetting" Style="{StaticResource SettingSelector}" SelectedValuePath="Name" SelectionChanged="Setting_Changed" AutomationProperties.Name="强调色">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Fill="{Binding Brush}" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </fluent:CardControl>
                            <fluent:CardControl Header="正文字号" Style="{StaticResource SettingCard}" Icon="{fluent:SymbolIcon TextFontSize20, FontSize=24}">
                                <ComboBox x:Name="FontSetting" Style="{StaticResource SettingSelector}" SelectionChanged="Setting_Changed" AutomationProperties.Name="正文字号"/>
                            </fluent:CardControl>
                            <fluent:CardControl Header="任务间距" Style="{StaticResource SettingCard}" Icon="{fluent:SymbolIcon TextLineSpacing20, FontSize=24}">
                                <ComboBox x:Name="DensitySetting" Style="{StaticResource SettingSelector}" SelectionChanged="Setting_Changed" AutomationProperties.Name="任务间距"/>
                            </fluent:CardControl>
                            <fluent:CardControl Header="动画效果" Style="{StaticResource SettingCard}" Icon="{fluent:SymbolIcon Sparkle20, FontSize=24}">
                                <ComboBox x:Name="MotionSetting" Style="{StaticResource SettingSelector}" SelectionChanged="Setting_Changed" AutomationProperties.Name="动画效果"/>
                            </fluent:CardControl>
                            <fluent:Button Content="恢复外观默认值" Icon="{fluent:SymbolIcon ArrowReset20, FontSize=20}" Click="ResetSettings_Click" HorizontalAlignment="Stretch" Margin="0,4,0,24"/>
                            <TextBlock Text="数据与关于" FontWeight="SemiBold" Margin="4,0,0,12"/>
                            <fluent:Button Content="打开 Data 目录" Icon="{fluent:SymbolIcon FolderOpen20, FontSize=20}" Click="OpenData_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                            <fluent:Button Content="打开备份目录" Icon="{fluent:SymbolIcon History20, FontSize=20}" Click="OpenBackup_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,16"/>
                            <fluent:CardAction x:Name="AboutCard" Click="OpenRepository_Click" IsChevronVisible="False" HorizontalContentAlignment="Stretch" ToolTip="打开 GitHub 仓库" AutomationProperties.Name="打开 ToDoList GitHub 仓库">
                                <fluent:CardAction.Content><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="AboutIcon" Width="40" Height="40" Margin="0,0,12,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="ToDoList  2.1.0" FontWeight="SemiBold"/><TextBlock Text="H-J-F · MIT · GitHub" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><fluent:SymbolIcon Grid.Column="2" Symbol="Open20" FontSize="20" Margin="12,0,0,0"/></Grid></fluent:CardAction.Content>
                            </fluent:CardAction>
                        </StackPanel>
                    </fluent:DynamicScrollViewer>
                </Grid>
            </Border>
            <Border Background="{DynamicResource PaperBrush}" Opacity="0.9" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="正在处理待办书…"/><ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"/></StackPanel></Border>
            <fluent:SnackbarPresenter x:Name="Notifications" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="24,0,24,178"/>
            <fluent:ContentDialogHost x:Name="DialogHost"/>
        </Grid>
    </Grid>
</fluent:FluentWindow>
